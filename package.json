{
  "name": "berrylauncher",
  "productName": "BerryLauncher",
  "version": "0.3.3",
  "description": "甜浆果启动器 - 辽宁科技大学甜浆果像素同好会开源 Minecraft 启动器",
  "main": "dist/main/index.js",
  "author": "USTL Sweet Berry Pixel Club",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win zip --x64 -c.win.signAndEditExecutable=false && node scripts/patch-win-icon.cjs",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "e2e": "node scripts/e2e.mjs",
    "dist:win:native": "npm run build && electron-builder --win --x64",
    "dist:win:installer": "npm run build && electron-builder --win nsis --x64",
    "screenshots": "node scripts/screenshots.mjs",
    "mirror-check": "node scripts/mirror-check.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.9.3",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "zustand": "^5.0.8",
    "resedit": "^1.7.2",
    "pe-library": "^0.4.1"
  }
}